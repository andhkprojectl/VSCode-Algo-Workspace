<AmiBroker-Analysis CompactMode="0">
<General>
<FormatVersion>1</FormatVersion>
<Symbol>ES</Symbol>
<FormulaPath>C:\\Project\\ProjectLife\\amibroker\\system\\PL_20260729_1.0.0_ES_4003\\2 BackTest\\backtest_4003_1 trim_4_python.afl</FormulaPath>
<FormulaContent>function writeline2(s1) { \r\n//  \r\n// The following code writes all the above AddColumn to permanent logfile, where Filter occurs on last bar  \r\n//  \r\n\t\tfh = fopen( "TWSTrade111.log", "a");  \r\n\t\tif( fh )  \r\n\t\t{  \r\n\t\t\tfputs( Now(), fh );  \r\n\t\t\tfputs( ";", fh ); \r\n \r\n\t\t\tfputs( "inCubatio_NQ.afl", fh );  \r\n\t\t\tfputs( ";", fh ); \r\n \r\n\t\t\tfputs(s1, fh); \r\n\t\t\tfputs( "\\n", fh ); \r\n \r\n\t\t\tfclose( fh );  \r\n\t\t}  \r\n \r\n} \r\n \r\nfunction writeTradeLog(s1) { \r\n//  \r\n// The following code writes all the above AddColumn to permanent logfile, where Filter occurs on last bar  \r\n//  \r\n\t\tfh = fopen( "TWSTradeTrade.log", "a");  \r\n\t\tif( fh )  \r\n\t\t{  \r\n\t\t\tfputs( Now(), fh );  \r\n\t\t\tfputs( ";", fh ); \r\n \r\n\t\t\tfputs( "inCubation_NQ.afl;" + Name() + ";", fh );  \r\n\t\t\tfputs( ";", fh ); \r\n \r\n\t\t\tfputs(s1, fh); \r\n\t\t\tfputs( "\\n", fh ); \r\n \r\n\t\t\tfclose( fh );  \r\n\t\t}  \r\n \r\n} \r\n \r\n////////////////////////////////////////////////////////////////////////////////////////////////// \r\n// Parameter \r\n////////////////////////////////////////////////////////////////////////////////////////////////// \r\nisTesting = True; \r\n \r\n \r\n////////////////////////////////////////////////////////////////////////////////////////////////// \r\n// Init system param\r\n////////////////////////////////////////////////////////////////////////////////////////////////// \r\n\r\nSetBacktestMode(backtestRegular);\r\n// SetBacktestMode(backtestRegularRaw );\r\n\r\nSetOption( "AllowSameBarExit", true);\r\nSetOption( "ActivateStopsImmediately", True);\r\n \r\n \r\n \r\n \r\nallowOpenNewPosition=true; \r\nallowSellCover = True;\r\n\r\n \r\n////////////////////////////////////////////////////////////////////////////////////////////////// \r\n// Buy/Sell condiction \r\n////////////////////////////////////////////////////////////////////////////////////////////////// \r\n\r\natr14T0 = ATR(14);\r\n\r\n\r\nminCO = Min(C, O);\r\nmaxCO = Max(C, O);\r\n\r\n\r\n////////////////////////////////////////////////////////////////////////////////////////////////// \r\n// return\r\n////////////////////////////////////////////////////////////////////////////////////////////////// \r\nrtTh = 1.5;\r\n\r\n// within 10 bars, h &gt; w*atr14\r\nmax3BarAtr14_1 = Ref(HHV(atr14T0, 3), -1); // max last 3 bars (exclude) current bar\r\n\r\n\r\nnext10BarHHV_H = Ref(Ref(HHV(H, 10), 10), 1);\r\nnext15BarHHV_H = Ref(Ref(HHV(H, 15), 15), 1);\r\nnext20BarHHV_H = Ref(Ref(HHV(H, 20), 20), 1);\r\n\r\n// next n bar L \r\nnext10BarLLV_L = Ref(Ref(LLV(L, 10), 10), 1);\r\nnext15BarLLV_L = Ref(Ref(LLV(L, 15), 15), 1);\r\nnext20BarLLV_L = Ref(Ref(LLV(L, 20), 20), 1);\r\n\r\n\r\n\r\n// buy rt\r\n// fix number of bars\r\nbuyRtB1 = (Ref(maxCO, 1) - maxCO) &gt;= rtTh;\r\nbuyRtB3 = (Ref(maxCO, 3) - maxCO) &gt;= rtTh;\r\nbuyRtB5 = (Ref(maxCO, 5) - maxCO) &gt;= rtTh;\r\nbuyRtB10 = (Ref(maxCO, 10) - maxCO) &gt;= rtTh;\r\nbuyRtB20 = (Ref(maxCO, 20) - maxCO) &gt;= rtTh;\r\nbuyRtB30 = (Ref(maxCO, 30) - maxCO) &gt;= rtTh;\r\n\r\n\r\n// within 10 bar\r\nmax3BarAtr14_1_15 = 1.5*max3BarAtr14_1;\r\nmax3BarAtr14_1_20 = 2.0*max3BarAtr14_1;\r\nmax3BarAtr14_1_30 = 3.0*max3BarAtr14_1;\r\n\r\nbuyAtr15ProfitTakePrice = Ref(O, 1) + max3BarAtr14_1_15;\r\nbuyAtr20ProfitTakePrice = Ref(O, 1) + max3BarAtr14_1_20;\r\nbuyAtr30ProfitTakePrice = Ref(O, 1) + max3BarAtr14_1_30;\r\n\r\n\r\nbuyRtAtr15 = next10BarHHV_H &gt;= buyAtr15ProfitTakePrice;\r\nbuyRtAtr20 = next10BarHHV_H &gt;= buyAtr20ProfitTakePrice;\r\nbuyRtAtr30 = next10BarHHV_H &gt;= buyAtr30ProfitTakePrice;\r\n\r\n// within 15 bar\r\nbuyRtAtr15_15bar = next15BarHHV_H &gt;= buyAtr15ProfitTakePrice;\r\nbuyRtAtr20_15bar = next15BarHHV_H &gt;= buyAtr20ProfitTakePrice;\r\nbuyRtAtr30_15bar = next15BarHHV_H &gt;= buyAtr30ProfitTakePrice;\r\n\r\n// within 20 bar\r\nbuyRtAtr15_20bar = next20BarHHV_H &gt;= buyAtr15ProfitTakePrice;\r\nbuyRtAtr20_20bar = next20BarHHV_H &gt;= buyAtr20ProfitTakePrice;\r\nbuyRtAtr30_20bar = next20BarHHV_H &gt;= buyAtr30ProfitTakePrice;\r\n\r\n// stop loss\r\nbuyAtr1StopLossPrice = Ref(O, 1) - max3BarAtr14_1;\r\n\r\n\r\n// within 10 bar. profit return (1.5, 2, 3)*atr and no L price &lt; 1*atr\r\nbuyRtAtr15_wo_sl = next10BarHHV_H &gt;= buyAtr15ProfitTakePrice AND NOT (next10BarLLV_L &lt; buyAtr1StopLossPrice);\r\nbuyRtAtr20_wo_sl = next10BarHHV_H &gt;= buyAtr20ProfitTakePrice AND NOT (next10BarLLV_L &lt; buyAtr1StopLossPrice);\r\nbuyRtAtr30_wo_sl = next10BarHHV_H &gt;= buyAtr30ProfitTakePrice AND NOT (next10BarLLV_L &lt; buyAtr1StopLossPrice);\r\n\r\n// within 15 bar. profit return (1.5, 2, 3)*atr and no L price &lt; 1*atr\r\nbuyRtAtr15_15bar_wo_sl = next15BarHHV_H &gt;= buyAtr15ProfitTakePrice  AND NOT (next10BarLLV_L &lt; buyAtr1StopLossPrice);\r\nbuyRtAtr20_15bar_wo_sl = next15BarHHV_H &gt;= buyAtr20ProfitTakePrice  AND NOT (next10BarLLV_L &lt; buyAtr1StopLossPrice);\r\nbuyRtAtr30_15bar_wo_sl = next15BarHHV_H &gt;= buyAtr30ProfitTakePrice  AND NOT (next10BarLLV_L &lt; buyAtr1StopLossPrice);\r\n\r\n// within 15 bar. profit return (1.5, 2, 3)*atr and no L price &lt; 1*atr\r\nbuyRtAtr15_20bar_wo_sl = next20BarHHV_H &gt;= buyAtr15ProfitTakePrice AND NOT (next10BarLLV_L &lt; buyAtr1StopLossPrice);\r\nbuyRtAtr20_20bar_wo_sl = next20BarHHV_H &gt;= buyAtr20ProfitTakePrice AND NOT (next10BarLLV_L &lt; buyAtr1StopLossPrice);\r\nbuyRtAtr30_20bar_wo_sl = next20BarHHV_H &gt;= buyAtr30ProfitTakePrice AND NOT (next10BarLLV_L &lt; buyAtr1StopLossPrice);\r\n\r\n\r\n\r\n// short rt\r\nshortAtr1StopLossPrice = Ref(O, 1) + max3BarAtr14_1;\r\n\r\n// fix number of bars\r\nshortRtB1 = (minCO - Ref(minCO, 1)) &gt;= rtTh;\r\nshortRtB3 = (minCO - Ref(minCO, 3)) &gt;= rtTh;\r\nshortRtB5 = (minCO - Ref(minCO, 5)) &gt;= rtTh;\r\nshortRtB10 = (minCO - Ref(minCO, 10)) &gt;= rtTh;\r\nshortRtB20 = (minCO - Ref(minCO, 20)) &gt;= rtTh;\r\nshortRtB30 = (minCO - Ref(minCO, 30)) &gt;= rtTh;\r\n\r\n\r\n// within 10 bar\r\nmax3BarAtr14_1_15 = 1.5*max3BarAtr14_1;\r\nmax3BarAtr14_1_20 = 2.0*max3BarAtr14_1;\r\nmax3BarAtr14_1_30 = 3.0*max3BarAtr14_1;\r\n\r\nshortAtr15ProfitTakePrice = Ref(O, 1) - max3BarAtr14_1_15;\r\nshortAtr20ProfitTakePrice = Ref(O, 1) - max3BarAtr14_1_20;\r\nshortAtr30ProfitTakePrice = Ref(O, 1) - max3BarAtr14_1_30;\r\n\r\nshortRtAtr15 = next10BarLLV_L &lt;= shortAtr15ProfitTakePrice;\r\nshortRtAtr20 = next10BarLLV_L &lt;= shortAtr20ProfitTakePrice;\r\nshortRtAtr30 = next10BarLLV_L &lt;= shortAtr30ProfitTakePrice;\r\n\r\n// within 15 bar\r\nshortRtAtr15_15bar = next15BarLLV_L &lt;= shortAtr15ProfitTakePrice;\r\nshortRtAtr20_15bar = next15BarLLV_L &lt;= shortAtr20ProfitTakePrice;\r\nshortRtAtr30_15bar = next15BarLLV_L &lt;= shortAtr30ProfitTakePrice;\r\n\r\n// within 20 bar\r\nshortRtAtr15_20bar = next20BarLLV_L &lt;= shortAtr15ProfitTakePrice;\r\nshortRtAtr20_20bar = next20BarLLV_L &lt;= shortAtr20ProfitTakePrice;\r\nshortRtAtr30_20bar = next20BarLLV_L &lt;= shortAtr30ProfitTakePrice;\r\n\r\n// stop loss\r\nshortAtr1StopLossPrice = Ref(O, 1) + max3BarAtr14_1;\r\n\r\n\r\n// within 10 bar. profit return (1.5, 2, 3)*atr and no H price &gt; 1*atr\r\nshortRtAtr15_wo_sl = next10BarLLV_L &lt;= shortAtr15ProfitTakePrice and NOT (next10BarHHV_H &gt; shortAtr1StopLossPrice);\r\nshortRtAtr20_wo_sl = next10BarLLV_L &lt;= shortAtr20ProfitTakePrice and NOT (next10BarHHV_H &gt; shortAtr1StopLossPrice);\r\nshortRtAtr30_wo_sl = next10BarLLV_L &lt;= shortAtr30ProfitTakePrice and NOT (next10BarHHV_H &gt; shortAtr1StopLossPrice);\r\n\r\n// within 15 bar. profit return (1.5, 2, 3)*atr and no H price &gt; 1*atr\r\nshortRtAtr15_15bar_wo_sl = next15BarLLV_L &lt;= shortAtr15ProfitTakePrice and NOT (next10BarHHV_H &gt; shortAtr1StopLossPrice);\r\nshortRtAtr20_15bar_wo_sl = next15BarLLV_L &lt;= shortAtr20ProfitTakePrice and NOT (next10BarHHV_H &gt; shortAtr1StopLossPrice);\r\nshortRtAtr30_15bar_wo_sl = next15BarLLV_L &lt;= shortAtr30ProfitTakePrice and NOT (next10BarHHV_H &gt; shortAtr1StopLossPrice);\r\n\r\n\r\n// within 20 bar. profit return (1.5, 2, 3)*atr and no H price &gt; 1*atr\r\nshortRtAtr15_20bar_wo_sl = next20BarLLV_L &lt;= shortAtr15ProfitTakePrice and NOT (next10BarHHV_H &gt; shortAtr1StopLossPrice);\r\nshortRtAtr20_20bar_wo_sl = next20BarLLV_L &lt;= shortAtr20ProfitTakePrice and NOT (next10BarHHV_H &gt; shortAtr1StopLossPrice);\r\nshortRtAtr30_20bar_wo_sl = next20BarLLV_L &lt;= shortAtr30ProfitTakePrice and NOT (next10BarHHV_H &gt; shortAtr1StopLossPrice);\r\n\r\n// divergence\r\n\r\n\r\n\r\nperiod1 = 20;\r\nhhvCOHist1 = HHV(maxCO, period1);\r\nLLVCOHist1 = LLV(minCO, period1);\r\nhhvCHist1 = HHV(C, period1);\r\nllvCHist1 = llv(C, period1);\r\n\r\n\r\n\r\nperiod2 = 3;\r\nregSlop20BarMaxCO = LinRegSlope(maxCO, period2);\r\nregSlop20BarMinCO = LinRegSlope(minCO, period2);\r\nregSlop20BarC = LinRegSlope(C, period2);\r\n\r\nhhvCHist1Bar = hhvBars(C, period1);\r\nllvCHist1Bar = LLVBars(C, period1);\r\nregSlop20BarCUp2Pts = (C - Ref(C, -llvCHist1Bar))/IIf(llvCHist1Bar==0, 1, llvCHist1Bar);\r\nregSlop20BarCDown2Pts = (C - Ref(C, -hhvCHist1Bar))/IIf(hhvCHist1Bar==0, 1, hhvCHist1Bar);\r\n\r\n\r\nstoch1 = StochK(9,3);\r\nhhvStoch1Hist1 = HHV(stoch1, period1);\r\nllvStoch1Hist1 = llv(stoch1, period1);\r\n// regSlop20BarStoch1 = LinRegSlope(stoch1, period2);\r\nregSlop20BarStoch1Down = LinRegSlope(stoch1, hhvCHist1Bar);\r\nregSlop20BarStoch1Up = LinRegSlope(stoch1, llvCHist1Bar);\r\n\r\nsumStoch93L20 = Sum(stoch1&lt;=35, 4);\r\nsumStoch93H80 = Sum(stoch1&gt;=65, 4);\r\n\r\n\r\ndiffCHHv = hhvCHist1 - C;\r\ndiffCLLV = C - llvCHist1;\r\n// &gt; 1 downtrend, &lt; 1 up trend, 0 - no trend\r\ndiffPer = diffCHHv/IIf(diffCLLV==0, 1, diffCLLV);\r\nisUp = IIf(diffPer &lt; 1, 1, 0);\r\n\r\n\r\n\r\n\r\n\r\n// 1. divergence case 1. bar from by H/L price\r\nhhvH = HHV(H, period1);\r\nhhvHBar = HHVBars(H, period1);\r\nllvL = LLV(L, period1);\r\nllvLBar = LLVBars(L, period1);\r\n\r\nstoch1AtH = Ref(stoch1, -hhvHBar);\r\nstoch1AtL = Ref(stoch1, -llvLBar);\r\n\r\nisBullDiverg = L &lt; llvL AND stoch1 &gt; stoch1AtL;\r\nisBearDiverg = H &gt; hhvH AND stoch1 &lt; stoch1AtH;\r\n\r\n\r\n\r\n// 2. divergence case 2. bar from stoch1\r\nhhvStoch12 = HHV(stoch1, period1);\r\nhhvStoch1Bar2 = HHVBars(stoch1, period1);\r\nllvStoch12 = LLV(stoch1, period1);\r\nllvStoch1Bar2 = LLVBars(stoch1, period1);\r\n\r\nhAtH2 = Ref(H, -hhvStoch1Bar2);\r\nlAtL2 = Ref(L, -llvStoch1Bar2);\r\n\r\nisBullDiverg2 = L &lt; lAtL2 AND stoch1 &gt; llvStoch12;\r\nisBearDiverg2 = H &gt; hAtH2 AND stoch1 &lt; hhvStoch12;\r\n\r\n\r\n\r\nisDiverg = isBullDiverg == True OR isBearDiverg == True\r\n\t\tOR isBullDiverg2 == True OR isBearDiverg2 == True\r\n\t\t;\r\n\r\n// 3 stoch\r\nstoch2 = StochK(14,3);\r\nstoch3 = StochK(40,4);\r\nstoch4 = StochK(60,5);\r\n\r\nbullishStoch20 = stoch1 &lt;= 25 AND stoch2 &lt;= 25 AND stoch3 &lt;= 20 AND stoch4 &lt;= 20;\r\nbearishStoch80 = stoch1 &gt;= 75 AND stoch2 &gt;= 75 AND stoch3 &gt;= 80 AND stoch4 &gt;= 80;\r\nbullishOrBearishStochTh = bullishStoch20 == True OR bearishStoch80 == True;\r\n\r\n\r\nbullishStoch20_2 = stoch1 &lt;= 25 AND stoch2 &lt;= 25 AND stoch3 &lt;= 30 AND stoch4 &lt;= 30;\r\nbearishStoch80_2 = stoch1 &gt;= 75 AND stoch2 &gt;= 75 AND stoch3 &gt;= 65 AND stoch4 &gt;= 65;\r\nbullishOrBearishStochTh_2 = bullishStoch20_2 == True OR bearishStoch80_2 == True;\r\n\r\n// 4. cross down or cross up\r\nema9 = EMA(C, 9);\r\ncrossDownEma9 = Cross(ema9, C) OR (O &gt; ema9 AND C &lt; ema9);\r\ncrossUpEma9 = Cross(C, ema9) OR (O &lt; ema9 AND C &gt; ema9);\r\nisCrossEma9 = crossDownEma9 OR  crossUpEma9;\r\n\r\n\r\nstochCrossUp = Cross(stoch1, 20);\r\nstochCrossDown = Cross(80, stoch1);\r\n\r\n// 5. large body\r\n// --- Logic ---\r\n// a. Calculate the current bar's absolute body\r\nbodySize = abs(close - open);\r\n\r\nnumBars = 100;\r\nbodySizeRankTop = Percentile( bodySize, numBars, 70);\r\nbodySizeRankBot = Percentile( bodySize, numBars, 30);\r\nbodySizeRankBot2 = Percentile( bodySize, numBars, 40);\r\n\r\nbodySizePer = abs(C-O)/(H-L);\r\n\r\nisLargeBody = bodySize &gt;= bodySizeRankTop AND bodySizePer &gt;= 0.65;\r\nisSmallBody = bodySize &lt;= bodySizeRankBot AND bodySizePer &lt;= 0.35;\r\nisSmallBody2 = bodySize &lt;= bodySizeRankBot2  AND bodySizePer &lt;= 0.35;\r\n\r\nhLsize = abs(H-L);\r\nhLSizeRankTop = Percentile( hLsize, numBars, 80);\r\nhLSizeRankBot = Percentile( hLsize, numBars, 20);\r\nhLSizeRankBot2 = Percentile( hLsize, numBars, 30);\r\n\r\nisLargeHl = hLsize &gt;= hLSizeRankTop;\r\nisSmallHl = hLsize &lt;= hLSizeRankBot;\r\nisSmallHl2 = hLsize &lt;= hLSizeRankBot2;\r\n\r\n\r\n// d. pattern\r\nisBullish = close &gt; Open;\r\nlargeBullishBody = isBullish and isLargeBody;\r\nlargeBulllishHl = isBullish AND isLargeHl;\r\n\r\nisBearish = close &lt; Open;\r\nlargeBearishBody = isBearish and isLargeBody;\r\nlargeBearishHl = isBearish and isSmallHl;\r\n\r\n// among current bar minCO &lt; prev 4 bar\r\nlowMinCO = minCO &lt; Ref(minCO, -1) AND minCO &lt; Ref(minCO, -2)\r\n\t\t\t\tAND minCO &lt; Ref(minCO, -3) AND minCO &lt; Ref(minCO, -4)\r\n\t\t\t\t;\r\n\r\n\r\n\r\n// 5. top reversal pattern\r\n// \r\n// a. engulfing pattern. close lowest of last 3 bars, open is highest of last 3 bars, large body size\r\n//topEngulfing1 = C &lt;= Ref(C, -1) AND C &lt;= Ref(C, -2) AND C &lt;= Ref(C, -3)\r\n\t\t\t\t//AND O &gt;= Ref(O, -1) AND O &gt;= Ref(O, -2) AND O &gt;= Ref(O, -3)\r\ntopEngulfing1 = minCO &lt; Ref(minCO, -1) AND maxCO &gt; Ref(maxCO, -1)\t\t\t;\r\nbearishEngulfing = topEngulfing1 AND (largeBearishBody OR largeBearishHl);\r\nbullishEngulfing = topEngulfing1 AND (largeBullishBody OR largeBulllishHl);\r\n\t\t\t\r\n// largeBulllishHl = isBullish AND isLargeHl;\t\t\t\r\n//bodySizePer = abs(C-O)/(H-L);\r\n//numBars = 100;\r\n//bodySizeRankBot2 = Percentile( bodySize, numBars, 40);\r\n//isSmallBody2 = bodySize &lt;= bodySizeRankBot2  AND bodySizePer &lt;= 0.35;\r\n//largeBearishBody = isBearish and isLargeBody;\r\n//bodySizeRankTop = Percentile( bodySize, numBars, 70);\r\n//isLargeBody = bodySize &gt;= bodySizeRankTop AND bodySizePer &gt;= 0.65;\r\n\r\ndiffCO = abs(C - O);\r\nbodyHLPer = diffCO*1.0000/IIf((H-L)== 0, 1, (H-L));\r\nrng = diffCO/minCO;\r\nsmallBodyTh0 = 0.45;\r\nsmallBody= bodyHLPer &gt;= 0.0 AND bodyHLPer &lt; smallBodyTh0;\r\nlowerShadow = Min(O,C) - L;\r\nmediumSizeLowerShadow = lowerShadow &gt; (H - L)*0.6 OR  abs(C-O)*1.5 &lt; lowershadow ;\r\nsmallRealBody = smallbody;\r\nshavenHead = abs(H - Max(O,C))/Max(O,C) &lt; 0.00045;\r\ncandleStickHammer = mediumSizeLowerShadow AND smallRealBody  AND shavenHead;\r\n\r\nuppershadow = H - Max(O,C);\r\nmediumSizeUpperShadow = uppershadow &gt; (H - L)*0.6 OR  abs(C-O)*1.5 &lt; uppershadow ;  // shadow &gt; 4times body\r\nshavenBottom = abs(L - Min(O,C))/Min(O,C) &lt; 0.00045;\r\ncandleStickInvertedHammer = mediumSizeUpperShadow AND smallRealBody  AND shavenBottom;\r\n\r\nhammerBar = candleStickHammer OR candleStickInvertedHammer;\r\n \r\n\r\ntopMiddleBar = Ref(H, -1) &gt;= Ref(H, -2) AND Ref(H, -1) &gt;= H\r\n\t\t\tOR Ref(maxCO, -1) &gt;= Ref(maxCO, -2) AND Ref(maxCO, -1) &gt;= maxCO\r\n\t\t\t;\r\n\r\ntop3BarReveral1 = // Ref(largeBulllishHl, -2)\r\n\t\t\t\tRef(isBullish, -2)\r\n\t\t\t\t // AND  Ref(isSmallBody2, -1) AND 2*Ref(bodysize, -1) &lt;= Ref(bodysize, -2) AND Ref(hammerBar, -1) AND topMiddleBar\r\n\t\t\t\t AND  2*Ref(bodysize, -1) &lt;= Ref(bodysize, -2) AND Ref(hammerBar, -1) AND topMiddleBar \r\n\t\t\t\tAND isBearish AND minCO &lt; Ref(minCO, -1) AND minCO &lt; Ref(minCO, -2) AND bodysize &gt;= 2*Ref(bodysize, -1) \r\n\t\t\t\t ; \r\n\t\t\t\t \r\ntop3BarReveral2 = // Ref(largeBulllishHl, -2)\r\n\t\t\t\tRef(candleStickInvertedHammer, -2)\r\n\t\t\t\t // AND  Ref(isSmallBody2, -1) AND Ref(hammerBar, -1) AND topMiddleBar\r\n\t\t\t\t AND  Ref(hammerBar, -1) AND topMiddleBar\r\n\t\t\t\tAND isBearish AND minCO &lt; Ref(minCO, -1) AND minCO &lt; Ref(minCO, -2) AND bodysize &gt;= 2*Ref(bodysize, -1) AND bodysize &gt;= 2*Ref(bodysize, -2) \r\n\t\t\t\t ;\t\t\t\t \r\n\r\ntop3BarReveral00 = top3BarReveral1 OR top3BarReveral2;\r\n\r\n\r\n// for c &lt; ma200\r\ntop3BarReveral3 = Ref(isBullish, -2)\r\n\t\t\t\t AND  (Ref(hammerBar, -1) OR Ref(largeBullishBody, -1) OR Ref(largeBulllishHl, -1) ) AND topMiddleBar \r\n\t\t\t\tAND isBearish AND minCO &lt; Ref(minCO, -1) AND minCO &lt; Ref(minCO, -2)\r\n\t\t\t\t ; \r\n\t\t\t\t \r\n\r\ntop3BarReveral01 = top3BarReveral3 ;\r\n\r\n// 6. VWAP\r\n\r\n\r\nTypicalPrice = (H + L + C) / 3;\r\n\r\n// . Identify the Reset Condition (1st day of the month)\r\n// Month() changes when a new month rolls over. BarIndex() == 0 handles the first loaded bar.\r\nisNewMonth = Month() != Ref(Month(), -1);\r\nisFirstBar = BarIndex() == 0;\r\nresetCondition = isNewMonth OR isFirstBar;\r\n\r\n// . Vectorized Cumulative Calculations (Zero Loops = Instant Load)\r\nPV = TypicalPrice * V;\r\n\r\ncumPV = Cum(PV);\r\ncumV  = Cum(V);\r\n\r\n// Capture the cumulative values exactly 1 bar *before* the reset.\r\n// This allows us to isolate the current month's accumulation by subtracting historical data.\r\nstartPV = ValueWhen(resetCondition, cumPV - PV);\r\nstartV  = ValueWhen(resetCondition, cumV - V);\r\n\r\nMonthlySumPV = cumPV - startPV;\r\nMonthlySumV  = cumV - startV;\r\n\r\n// . Calculate Core VWAP\r\n//VWAP = IIf(MonthlySumV &gt; 0, MonthlySumPV / MonthlySumV, TypicalPrice);\r\n\r\n\r\n\r\n// 1. Detect if the current bar is in a different month than the previous bar\r\n//newMonth = Month() != Ref( Month(), -1 );\r\n\r\n// 2. Account for the very first bar in the entire chart array to prevent null references\r\n// isFirstBarOfMonth = newMonth OR BarIndex() == 0;\r\n\r\n// 3. Calculate the number of bars since the condition was met\r\nbarsFromStartOfMonth = BarsSince( resetCondition );\r\n\r\nvrange = barsFromStartOfMonth;\r\n\r\n// vrange = Param("VWMA range", 50, 1, 200 );\r\n//mrange = Param("MA range", 70, 1, 200 );\r\n\r\nvsum = Sum( Volume, vrange );\r\nvpsum = Sum( Close * Volume, vrange );\r\n\r\nVWAP = vpsum / vsum;\r\n\r\n// Plot( C, Date() + " Close", colorDefault, styleCandle );\r\n\r\n// Plot( vwma, "VWMA" + vrange, colorRed );\r\n// Plot( MA( C, mrange ), "MA" + mrange, colorBlue );\r\n\r\n\r\n// . Enhancement: VWAP Standard Deviation Bands\r\nvwap2 = Nz(VWAP);\r\n// Calculate Volume-Weighted Variance\r\nPriceDiffSq = (TypicalPrice - vwap2) ^ 2;\r\nCumPriceDiffSq = Cum(PriceDiffSq * V);\r\n\r\n// Reset the variance at the start of the month using the same vectorized logic\r\nStartPriceDiffSq = ValueWhen(resetCondition, CumPriceDiffSq - (PriceDiffSq * V));\r\nMonthlyVariance = (CumPriceDiffSq - StartPriceDiffSq) / MonthlySumV;\r\n\r\n// Calculate the Standard Deviation\r\nVWAP_SD = sqrt(MonthlyVariance);\r\n\r\n// Define the SD Bands\r\nUpperBand1 = VWAP + VWAP_SD;\r\nLowerBand1 = VWAP - VWAP_SD;\r\nUpperBand2 = VWAP + (2 * VWAP_SD);\r\nLowerBand2 = VWAP - (2 * VWAP_SD);\r\n\r\n\r\nbearishVWAP1 = maxCO &gt;= UpperBand1;\r\n\r\n\r\nvrange1 = 50;\r\n\r\n\r\nvsum1 = Sum( Volume, vrange1 );\r\nvpsum1 = Sum( Close * Volume, vrange1);\r\n\r\nvwap11 = vpsum1 / vsum1;\r\n\r\nvwap50_2 = Nz(vwap11);\r\n\r\nregSlop5vwap50Bar = LinRegSlope(vwap50_2, 5);\r\nregSlop5vwap50BarL0 = regSlop5vwap50Bar &lt; -0.01;\r\nregSlop5vwap50BarL0Sum15 = Sum(regSlop5vwap50BarL0, 5);\r\n\r\nregSlop5vwap50BarH0 = regSlop5vwap50Bar &gt; 0.01;\r\nregSlop5vwap50BarH0Sum15 = Sum(regSlop5vwap50BarH0, 5);\r\n\r\nregSlop3Vwap50Bar = LinRegSlope(vwap50_2, 3);\r\nregSlop10vwap50Bar = LinRegSlope(vwap50_2, 10);\r\nregSlop20vwap50Bar = LinRegSlope(vwap50_2, 20);\r\n\r\nregSlop3Vwap50BarSum3 = Sum(regSlop3Vwap50Bar &lt; 0, 3);\r\n\r\nregSlop3Vwap50BarDiff = (regSlop3Vwap50Bar - Ref(regSlop3Vwap50Bar, -1))/IIf(Ref(regSlop3Vwap50Bar, -1) == 0, 1, Ref(regSlop3Vwap50Bar, -1));\r\nregSlop5Vwap50BarDiff = (regSlop5Vwap50Bar - Ref(regSlop5Vwap50Bar, -1))/IIf(Ref(regSlop5Vwap50Bar, -1) == 0, 1, Ref(regSlop5Vwap50Bar, -1));\r\n\r\n\r\nvsum9 = Sum( Volume, 9);\r\nvpsum9 = Sum( Close * Volume, 9);\r\nvwap9 = vpsum9 / vsum9;\r\nvwap9_2 = Nz(vwap9);\r\nregSlop5Vwap9Bar = LinRegSlope(vwap9_2, 5);\r\n\r\nvsum20 = Sum( Volume, 20);\r\nvpsum20 = Sum( Close * Volume, 20);\r\nvwap20 = vpsum20 / vsum20;\r\nvwap20_2 = Nz(vwap20);\r\nregSlop5Vwap20Bar = LinRegSlope(vwap20_2, 5);\r\n\r\nvsum6 = Sum( Volume, 6);\r\nvpsum6 = Sum( Close * Volume, 6);\r\nvwap6 = vpsum6 / vsum6;\r\nvwap6_2 = Nz(vwap6);\r\nregSlop5Vwap6Bar = LinRegSlope(vwap6_2, 5);\r\nregSlop3Vwap6Bar = LinRegSlope(vwap6_2, 3);\r\n\r\nvsum3 = Sum( Volume, 3);\r\nvpsum3 = Sum( Close * Volume, 3);\r\nvwap3 = vpsum3 / vsum3;\r\nvwap3_2 = Nz(vwap3);\r\n\r\n\r\ncrossUpVWap50_3 = Cross(vwap3_2, vwap50_2 ) ;\r\ncrossDownVWap50_3 = Cross(vwap50_2, vwap3_2) ;\r\n\r\ncrossDownVWap50_3Sum = Sum(crossDownVWap50_3, 15);\r\n\r\n\r\n\r\nstoch1 = StochK(9,3);\r\nregSlop3Stoch1 = LinRegSlope(stoch1, 3);\r\n\r\n\r\nisBullDiverg3 = vwap6_2 &lt; Ref(vwap6_2, -2) \r\n\t\t\t\tAND regSlop3Vwap6Bar &lt; 0\r\n\t\t\t\tAND stoch1 &gt; Ref(stoch1, -2)\r\n\t\t\t\tAND regSlop3Stoch1 &gt; 0\r\n\t\t\t\t;\r\nisBearDiverg3 = vwap6_2 &gt; Ref(vwap6_2, -2) \r\n\t\t\t\tAND regSlop3Vwap6Bar &gt; 0\r\n\t\t\t\tAND stoch1 &lt; Ref(stoch1, -2)\r\n\t\t\t\tAND regSlop3Stoch1 &lt; 0\r\n\t\t\t\t;\r\n\r\n/*\r\nlargeBullishBody = isBullish and isLargeBody;\r\nlargeBulllishHl = isBullish AND isLargeHl;\r\n\r\nisBearish = close &lt; Open;\r\nlargeBearishBody = isBearish and isLargeBody;\r\nlargeBearishHl = isBearish and isSmallHl;\r\n*/\r\n\r\ncrossDownVWap50 = Cross(vwap50_2, C) \r\n\t\t\t\t\tOR (O &gt; vwap50_2 AND C &lt; vwap50_2)\r\n\t\t\t\t\t;\r\ncrossUpVWap50 = Cross(C, vwap50_2) \r\n\t\t\t\t\tOR (O &lt; vwap50_2 AND C &gt; vwap50_2)\r\n\t\t\t\t\t;\t\t\t\t\t\r\n\r\nhhvBar5_1 = HHVBars(H, 5);\r\nhhvBar5_2 = HHVBars(maxCO, 5);\r\n\r\nllvBar5_1 = LLVBars(L, 5);\r\nllvBar5_2 = LLVBars(minCO, 5);\r\n\r\n// within 4 bars, 2 bars\r\npriceActionUp2Bar1 = Ref(largeBearishBody, -1) AND Ref(crossDownVWap50, -1)\r\n\t\t\t\t\t AND largeBullishBody AND crossUpVWap50\r\n\t\t\t\t\t AND (hhvBar5_1 == 0 OR hhvBar5_2 == 0) // current bar is highest bar within 5\r\n\t\t\t\t\t ;\r\n//crossDownThenUpVwap50_3bars =\r\npriceActionUp4Bar1 = (Ref(largeBearishBody, -3) or Ref(largeBearishBody, -2))\r\n\t\t\t\t\t AND (Ref(crossDownVWap50, -3) or Ref(crossDownVWap50, -2))\r\n\t\t\t\t\t AND Ref(largeBullishBody, -1) AND Ref(crossUpVWap50, -1)\r\n\t\t\t\t\t AND (hhvBar5_1 == 0 OR hhvBar5_2 ==0) AND isBullish // current bar is highest bar within 5\r\n\t\t\t\t;\r\n\t\t\t\t\r\npriceActionUp4Bar2 = (Ref(largeBullishBody, -3) or Ref(largeBullishBody, -2)) \r\n\t\t\t\t\t AND (Ref(crossUpVWap50, -3) or Ref(crossUpVWap50, -2))\r\n\t\t\t\t\t AND Ref(largeBearishBody, -1) AND Ref(crossDownVWap50, -1)\r\n\t\t\t\t\t AND (llvBar5_1 == 0 OR llvBar5_2 ==0) AND isBullish // current bar is highest bar within 5\r\n\t\t\t\t;\t\t\t\t\t \t\t\t\t\r\n\r\nhhvBar12_1 = HHVBars(H, 12);\r\nhhvBar12_2 = HHVBars(maxCO, 12);\r\nhhv12_1 = HHV(H, 12);\r\nhhv12_2 = HHV(maxCO, 12);\r\n\r\n\r\nllvBar12_1 = LLVBars(L, 12);\r\nllvBar12_2 = LLVBars(minCO, 12);\r\nllv12_1 = LLV(L, 12);\r\nllv12_2 = LLV(minCO, 12);\r\n\r\nbuyFilterCond4 = Ref(regSlop3Vwap50BarSum3, -1) == 3 AND regSlop3Vwap50Bar &gt; 0\r\n\t\t\t  AND isBullDiverg3 &gt; 0\r\n\t\t\t  AND crossDownVWap50_3Sum &gt; 0\r\n\t\t\t  ;\r\n\t\t\t\t\r\npriceActionDown2Bar1 = // Ref(largeBullishBody, -1) \r\n\t\t\t\t\t Ref(isBullish, -1) \r\n\t\t\t\t\t AND Ref(crossUpVWap50, -1)\r\n\t\t\t\t\t // AND topEngulfing1\r\n\t\t\t\t\t AND largeBearishBody AND crossDownVWap50\r\n\t\t\t\t\t AND (minCO &lt; Ref(minCO, -1) OR L &lt; Ref(L, -1))\r\n\t\t\t\t\t AND (hhvBar12_1 &gt; llvBar12_1 OR hhvBar12_2 &gt; llvBar12_2) // prev high bar then low bar then current bar pull back\r\n\t\t\t\t\t and (hhv12_2 &gt; maxCO and llv12_2 &lt; minCO) // prev high value &gt; current bar hih and prev low value &lt; current low\r\n\t\t\t\t\t ;\r\n\t\t\t\t\t \r\npriceActionDown2Bar2 = //Ref(largeBullishBody, -1) \r\n\t\t\t\t\tRef(isBullish, -1) \r\n\t\t\t\t\t AND Ref(crossUpVWap50, -1)\r\n\t\t\t\t\t AND largeBearishBody AND crossDownVWap50\r\n\t\t\t\t\t AND (minCO &lt; Ref(minCO, -1) OR L &lt; Ref(L, -1)) // englufing candle\r\n\t\t\t\t\t AND (maxCO &gt; Ref(maxCO, -1) OR H &gt; Ref(H, -1))\r\n\t\t\t\t\t ;\r\n\t\t\t\t\t \r\n// reverse of priceActionUp2Bar1\r\npriceActionDown2Bar3 = Ref(largeBullishBody, -1) AND Ref(crossUpVWap50, -1)\r\n\t\t\t\t\t AND largeBearishBody AND crossDownVWap50\r\n\t\t\t\t\t AND (llvBar5_1 == 0 OR llvBar5_2 == 0) // current bar is lowest bar within 5 bars\r\n\t\t\t\t\t ;\t\t\t\t\t \t\t\t\t\t \r\n\t\t\t\t\t \r\npriceActionDown3Bar1 = \tRef(isbullish, -2)\r\n\t\t\t\t\t AND Ref(isBearish, -1)\r\n\t\t\t\t\t AND (Ref(minCO, -2) &gt; Ref(minCO, -1) OR Ref(L, -2) &gt; Ref(L, -1)) // englufing candle\r\n\t\t\t\t\t AND (Ref(maxCO, -2) &lt; Ref(maxCO, -1) OR Ref(H, -2) &lt; Ref(H, -1))\r\n\t\t\t\t\t AND isBearish AND crossDownVWap50\r\n\t\t\t\t\t ;\t\t\t\t\t \t\t\t\t\t \r\n\t\t\t\t\t \r\npriceActionDown3Bar2 = \tRef(isbullish, -2) AND Ref(minCO, -2) &lt; Ref(vwap50_2, -2) AND Ref(regSlop3Vwap50Bar, -2) &gt; 0\r\n\t\t\t\t\t AND Ref(maxCO, -1) &gt; Ref(vwap50_2, -1)\r\n\t\t\t\t\t AND largeBearishBody AND minCO &lt; vwap50_2 AND LLV(L, 3) == L AND regSlop3Vwap50Bar &lt; 0\r\n\t\t\t\t\t ;\t\t\t\t\t \r\n\t\t\t\t\t\r\n// reverse of priceActionUp4Bar1\t\t\t\t\t \r\npriceActionDown4Bar1 = priceActionUp4Bar2\r\n\t\t\t\t;\t\t\t\t\t \r\n\t\t\t\t\t \r\n\r\n\r\n// 7. ma\r\nma100 = MA(C, 100);\r\nma200 = MA(C, 200);\r\nregSlop100C = LinRegSlope(ma100, 3);\r\nregSlop200C = LinRegSlope(ma200, 3);\r\n\r\n\r\n\r\n// setup 1\r\nbuy01 = regSlop5vwap50BarH0Sum15 &gt;= 4  // within 15 bars, 14 bars &gt; 0.01\r\n\t\t// AND sumStoch93L20 &gt;= 1 // within last 4 bars, at least 1 bar stoch (9,3) &lt;= 20\r\n\t\tAND (\r\n\t\t\tpriceActionUp2Bar1\r\n\t\t\tOR priceActionUp4Bar1\r\n\t\t)\r\n\t\t;\r\n\t\t\r\nbuy01_1 = regSlop5vwap50BarH0Sum15 &gt;= 4  AND priceActionUp2Bar1;\r\nbuy01_2 = regSlop5vwap50BarH0Sum15 &gt;= 4  AND priceActionUp4Bar1;\r\nbuy01_3 = regSlop5vwap50BarH0Sum15 &gt;= 4  AND priceActionUp4Bar2;\r\nbuy01_3_2 = priceActionUp4Bar2;\r\n\r\n\t\r\n// setup 2\t\r\nbuy02 = Ref(regSlop3Vwap50Bar, -1) &lt; 0 \r\n\t\tAND regSlop3Vwap50Bar &gt; 0\r\n\t\tAND Sum(crossUpVWap50, 4) &gt; 0\r\n\t\tAND isbullish AND Ref(isbullish, -1)\r\n\t\t;\r\n\t\t\r\n\t\t\r\n/*\t\t\r\nbuy00 = buy01\r\n\t\tOR buy02\r\n\t\t;\r\n*/\r\n\r\n// buy00 = buy01_3;\r\nbuy00 = buy01_3_2\r\n\t\t// OR buy02\r\n\t\t// buy01\r\n\t\t\t;\r\n\r\n\r\n\r\n// From 09:30 to 12:30\r\n// timeFilter = TimeNum() &gt;= 93000 AND TimeNum() &lt;= 123000;\r\n\r\n// From 10:00 to 12:30\r\n// timeFilterBuy = TimeNum() &gt;= 93000 AND TimeNum() &lt;= 123000;\r\n// timeFilterBuy = TimeNum() &gt;= 100000 AND TimeNum() &lt;= 120000;\r\n// timeFilterBuy = TimeNum() &gt;= 100000 AND TimeNum() &lt;= 120000;\r\n// timeFilterBuy = TimeNum() &gt;= 100000 AND TimeNum() &lt;= 113000;\r\n// timeFilterBuy = TimeNum() &gt;= 100000 AND TimeNum() &lt;= 120000;\r\ntimeFilterBuy = True;\r\n\r\n// Weekday filter: Allow buy only on Thursday (DayOfWeek() == 5)\r\n// weekdayFilterBuy = DayOfWeek() == 3;\r\n\r\nBuy = Ref(buy00, -1)\r\n\t  AND timeFilterBuy\r\n\t  // AND weekdayFilterBuy\r\n\t  AND allowOpenNewPosition \r\n; \r\n\r\nbuyShortPriceTh = Ref(atr14T0, -1)/4.0;\r\nBuyPrice=O - buyShortPriceTh; \r\n\r\n\r\n\r\n// setup 1\r\nshort01 = (\r\n\t\t\tpriceActionDown2Bar1\r\n\t\t\tOR priceActionDown4Bar1\r\n\t\t\tOR priceActionDown2Bar2\r\n\t\t\tOR priceActionDown3Bar1\r\n\t\t\t\r\n\t\t)\r\n\t\tAND regSlop5vwap50BarL0Sum15 &gt;= 4  // within 15 bars, 14 bars &gt; 0.01\r\n\t\t;\r\n\t\t\r\nshort01_1 = priceActionDown2Bar1;\r\nshort01_2 = priceActionDown4Bar1;\r\nshort01_3 = priceActionDown2Bar2;\r\nshort01_4 = priceActionDown3Bar1;\r\n\r\n\t\t\r\n// setup 2\t\r\nshort02 = Ref(regSlop3Vwap50Bar, -1) &gt; 0 \r\n\t\tAND regSlop3Vwap50Bar &lt; 0\r\n\t\tAND Sum(crossDownVWap50, 4) &gt; 0\r\n\t\tAND isBearish AND Ref(isBearish, -1)\r\n\t\tAND regSlop5vwap50BarL0Sum15 &gt;= 4  // within 15 bars, 14 bars &gt; 0.01\r\n\t\t;\t\t\r\n\t\t\r\nshort02_2 = priceActionDown3Bar2;\r\n\r\n\r\n// short00 = False;\t\t\r\nshort00 = short01_4\r\n\t\t  OR short02\r\n\t\t  ;\r\n\r\n\r\n\r\nShort = Ref(short00, -1)\r\n\t  AND timeFilterBuy\r\n\t  AND allowOpenNewPosition \r\n\t  ;\r\n \r\n\r\nShortPrice=O + buyShortPriceTh;\r\n\r\n\r\n\r\n// sellTh = Optimize("sellTh", 6, 2, 8, 1);\r\n\r\n// sellTh = 2;\r\n\r\n//sell00 = bullishBody AND bodySize &gt;= 2;\r\n//Sell = Ref(sell00, -1) == True\r\n//\t\tAND O &gt; Ref(O, -1)\r\n//\t\t;\r\n\r\nSell = False;\r\nSellPrice = O;\r\n\r\n//Cover = Buy AND (NOT Short);\r\n// Cover =False;\r\n//cover00 = (C &lt; Ref(llv1, -1) OR C &gt; Ref(C, -1) AND Ref(C, -1) &gt; Ref(C, -2));\r\n\r\n// coverTh = Optimize("coverTh", 3, 3, 10, 1);\r\n//cover00 = bearishBody AND bodySize &gt;= 2\r\n//\t\t\tAND O &lt; Ref(O, -1)\r\n//\t\t\t;\r\n//Cover = Ref(cover00, -1) == True;\t     \r\nCover = False;\r\nCoverPrice = O;\r\n\r\n\r\n\r\n\r\n// Buy=Short=Sell=Cover=False;\r\n\r\n\r\n\r\n\r\n// maxAtr14=HHV(atr14T0, 3);\r\nmaxAtr14=atr14T0;\r\n\r\n// stopLossPt = 50; // assume no stop loss\r\n// stopLossPt = maxAtr14;  // 1 ATR stop loss\r\nstopLossPt = max3BarAtr14_1;  // 1 ATR stop loss\r\n\r\n\r\n\r\n\r\n//max3BarAtr14_1_15 = 1.5*max3BarAtr14_1;\r\n//max3BarAtr14_1_20 = 2.0*max3BarAtr14_1;\r\n//max3BarAtr14_1_30 = 3.0*max3BarAtr14_1;\r\n\r\nprofit1Pt = 1.5*max3BarAtr14_1;\r\n// profit1Pt = 2.0*max3BarAtr14_1;\r\n\r\n\r\n\r\n\r\n\r\n// Trade tracking variables\r\nisInLong  = False;\r\nisInShort = False;\r\nlongEntryPrice  = 0;\r\nshortEntryPrice = 0;\r\nlongStopPrice        = 0;\r\nshortStopPrice       = 0;\r\nlongProfitPrice        = 0;\r\nshortProfitPrice       = 0;\r\n\r\nlongProfitPriceArr  = Null;\r\nlongStopPriceArr  = Null;\r\nlongBarindexArr = Null;\r\nlongBarindex = 0;\r\n\r\nshortProfitPriceArr = Null;\r\nshortStopPriceArr = Null;\r\nshortBarindexArr = Null;\r\nshortBarindex = 0;\r\n\r\nisInShortArr = Null;\r\nisInLongArr = Null;\r\n\r\nbuyForceCover = False;\r\nshortForceSell = False;\r\n\r\n// stopLossPrice1 = 0;\r\n// profitTakePrice1 = 0;\r\n\r\nliveStopLossPrice1 = 0;\r\nliveProfitTakePrice1 = 0;\r\n\r\n// N bar stop\r\nstopPeriod1 = 15;\r\n// stopPeriod1 = Optimize("stopPeriod1", 1, 1, 4, 1);\r\nsellStopNBarPeriod = 0;\r\n\r\n\r\ncoverSignal1 = 0;\r\nsellSignal1 = 0;\r\n\r\n/*\r\nif (isTesting == True) {\r\n\ttradePrice0 = O;  // backtest, use O\r\n}\r\nelse {\r\n\ttradePrice0 = C;  // live, use C\r\n}\r\n*/\r\ntradePrice0 = O;\r\nliveTradePrice0 = C;\r\n\r\n\r\n\r\n// use this\r\n// Loop through bars to track trades\r\nfor(i = 0; i &lt; BarCount; i++)\r\n{\r\n\r\n    // =====================\r\n    // Handling Buy\r\n    // =====================\r\n    if( Buy[i] AND !isInLong )  \r\n    {\r\n        longEntryPrice = tradePrice0[i];\r\n        longProfitPrice = longEntryPrice + profit1Pt[i];\r\n        longStopPrice = longEntryPrice - stopLossPt[i];\r\n        liveProfitTakePrice1 = liveTradePrice0[i] + profit1Pt[i];\r\n\t\tliveStopLossPrice1 = liveTradePrice0[i] - stopLossPt[i];        \r\n        \r\n        //profitTakePrice1[i] = longProfitPrice;\r\n        //stopLossPrice1[i] = longStopPrice;\r\n        \r\n        isInLong = True;\r\n        sellStopNBarPeriod = stopPeriod1;\r\n        longBarIndex = i;\r\n\t\tif (isInShort) {\r\n\t\t\tbuyForceCover = True;\r\n\t\t}\r\n\t\t\r\n    }\r\n    isInLongArr[i] = isInLong;\r\n    \r\n    // =====================\r\n    // Handling Short\r\n    // =====================\r\n    if( Short[i] AND !isInShort )  \r\n    {\r\n        shortEntryPrice = tradePrice0[i];\r\n        shortProfitPrice = shortEntryPrice - profit1Pt[i];\r\n        shortStopPrice = shortEntryPrice + stopLossPt[i];\r\n        liveProfitTakePrice1 = liveTradePrice0[i] - profit1Pt[i];\r\n\t\tliveStopLossPrice1 = liveTradePrice0[i] + stopLossPt[i];        \r\n        \r\n        // profitTakePrice1[i] = shortProfitPrice;\r\n        // stopLossPrice1[i] = shortStopPrice;\r\n        \r\n        isInShort = True;\r\n        shortBarIndex = i;\r\n\t\tif (isInLong) {\r\n\t\t\tshortForceSell = True;\r\n\t\t}\t\t\r\n        \r\n    }    \r\n    isInShortArr[i] = isInShort;    \r\n\t\r\n\t// ==========================================\r\n\t// Handling Stop Profit and Stop Loss for Buy\r\n\t// ==========================================\r\n    if( isInLong )\r\n    {\r\n        longProfitPriceArr[i] = longProfitPrice;  \r\n        \r\n        longStopPriceArr[i] = longStopPrice;  \r\n        \r\n        longBarindexArr[i] = longBarindex;        \r\n\r\n\t\t// =====================\r\n\t\t// Handling Stop Loss\r\n\t\t// =====================        \r\n        // if( (Low[i] &lt;= longStopPrice OR shortForceSell) AND isInLong == True)  // Exit if stop-loss hit\r\n        if( (Low[i] &lt;= longStopPrice OR shortForceSell) AND isInLong \r\n\t\t\tAND istesting  // only cater when testing. live use bracket order\r\n\t\t\t)  // Exit if stop-loss hit\r\n        {\r\n\t\t\tsellSignal1[i] = 2;\r\n            Sell[i] = 1;  \r\n            SellPrice[i] = longStopPrice;\r\n            Buy[i] = 0;\r\n            isInLong = False;\r\n            if (shortForceSell) {\r\n\t\t\t\tshortForceSell = False;\r\n\t\t\t\tSellPrice[i] = tradePrice0[i];\r\n\t\t\t}\r\n        }\t\t\r\n\t\t// =====================\r\n\t\t// Handling Stop Profit\r\n\t\t// =====================\r\n        // shortForceSell means within buy but later has short signal, force sell and then short\r\n        // if( (high[i] &gt;= longProfitPrice OR shortForceSell) AND isInLong == True)\r\n        if( (high[i] &gt;= longProfitPrice OR shortForceSell) \r\n\t\t\tAND isInLong\r\n\t\t\tAND istesting  // only cater when testing. live use bracket order\r\n\t\t\t)\r\n        {\r\n\t\t\tsellSignal1[i] = 1;\r\n            Sell[i] = 1;  \r\n            SellPrice[i] = longProfitPrice;\r\n            Buy[i] = 0;\r\n            isInLong = False;\r\n            if (shortForceSell) {\r\n\t\t\t\tshortForceSell = False;\r\n\t\t\t\tSellPrice[i] = tradePrice0[i];\r\n\t\t\t}\r\n        }        \r\n\t\t// =====================\r\n\t\t// N bar stop\r\n\t\t// =====================\r\n\t\t// isNbarStopSell = True;\r\n\t\t// if( (i - stopPeriod1) &gt;= 0 AND allowSellCover[i] == True AND isInLong\r\n\t\tif( (i - sellStopNBarPeriod) &gt;= 0 AND allowSellCover[i] == True AND isInLong\r\n\t\t\t AND Buy[ i ] != 1 // if current bar still Buy, do not sell, just keep 2 bar buy\r\n\t\t\t // AND (Buy[ i - stopPeriod1] == 1 OR shortForceSell) \r\n\t\t\t AND (Buy[ i - sellStopNBarPeriod] == 1 OR shortForceSell) \r\n\t\t\t \r\n\t\t\t) {\r\n\t\t\t\tisInLong = False;\r\n\t\t\t\tsellSignal1[i] = 3;\r\n\t\t\t\tSell[ i ] = 1; \r\n\t\t\t\tSellPrice[i] = tradePrice0[i];\r\n\t\t\t\t// Buy[i] = 0; // do not set Buy[i] = 0\r\n\t\t}\r\n\t\t// for consequent buy, do not sell at stopPeriod1 until consequent buy end. sellStopNBarPeriod = 1st buy bar\r\n\t\tif (Buy[ i - sellStopNBarPeriod] == 1 AND Buy[ i ] == 1) {\r\n\t\t\tsellStopNBarPeriod = sellStopNBarPeriod + 1;\r\n\t\t}\r\n    }\r\n\r\n\t// ============================================\r\n\t// Handling Stop Profit and Stop Loss for Short\r\n\t// =============================================\r\n    if( isInShort == true )\r\n    {\r\n        shortProfitPriceArr[i] = shortProfitPrice;  \r\n        shortStopPriceArr[i] = shortStopPrice;  \r\n        \r\n        shortBarindexArr[i] = shortBarIndex;        \r\n\r\n\t\t// =====================\r\n\t\t// Handling Stop Loss\r\n\t\t// =====================        \r\n\t\t// if( (high[i] &gt;= shortStopPrice OR buyForceCover) AND isInShort == True)  // Exit if stop-loss hit\r\n\t\tif( (high[i] &gt;= shortStopPrice OR buyForceCover) AND isInShort == True\r\n\t\t\tAND istesting  // only cater when testing. live use bracket order\r\n\t\t\t) // Exit if stop-loss hit\r\n        {\r\n\t\t\tcoverSignal1[i]= 2;\r\n            Cover[i] = 1;  \r\n            CoverPrice[i] = shortStopPrice;\r\n            Short[i] = 0;\r\n            isInShort = False;\r\n            if (buyForceCover) {\r\n\t\t\t\tbuyForceCover = False;\r\n\t\t\t\tCoverPrice[i] = tradePrice0[i];\r\n\t\t\t}\r\n    //        if (isInLong) {\r\n\t\t\t\t//isInLong = False;\r\n    //        }\r\n        }\r\n\r\n\t\t// =====================\r\n\t\t// Handling Stop Profit\r\n\t\t// =====================\r\n\t\t// if( (low[i] &lt;= shortProfitPrice OR buyForceCover) AND isInShort == True) \r\n\t\tif( (low[i] &lt;= shortProfitPrice OR buyForceCover) AND isInShort == True\r\n\t\t\tAND istesting  // only cater when testing. live use bracket order\r\n\t\t\t\t)\r\n        {\r\n\t\t\tcoverSignal1[i]= 1;\r\n            Cover[i] = 1;  \r\n            CoverPrice[i] = shortProfitPrice;\r\n            Short[i] = 0;\r\n            isInShort = False;\r\n            if (buyForceCover) {\r\n\t\t\t\tbuyForceCover = False;\r\n\t\t\t\tCoverPrice[i] = tradePrice0[i];\r\n\t\t\t}\r\n    //        if (isInLong) {\r\n\t\t\t\t//isInLong = False;\r\n    //        }\r\n        }        \r\n\r\n        \r\n\t\t// =====================\r\n\t\t// N bar stop\r\n\t\t// =====================\r\n\t\t// isNbarStopCover = True;\r\n\t\tif( (i - stopPeriod1) &gt;= 0 AND (Short[ i - stopPeriod1] == 1 OR buyForceCover) AND allowSellCover[i] == True AND isInShort == True\r\n\t\t\tAND Short[ i ] != 1 // if current bar still Short, do not cover, just keep 2 bar short\r\n\t\t\t) {\r\n\t\t\t\tcoverSignal1[i]= 3;\r\n\t\t\t\tisInShort = False;\r\n\t\t\t\tCover[ i ] = 1; \r\n\t\t\t\tCoverPrice[i] = tradePrice0[i];\r\n\t\t\t\r\n\t\t\t}\t\t\t\t\r\n\r\n\r\n        \r\n    }\r\n}\r\n\r\n\r\n\r\n// if not testing, use applystop\r\nif (istesting == False) {\r\n\tApplyStop(stopTypeLoss, stopModePoint, stopLossPt, 1, False); \r\n\tApplyStop(stopTypeProfit, stopModePoint, profit1Pt, 1, False ); \r\n}\r\n\r\n\r\n// ------------------------------------------------------\r\n// end. stop loss and profit. replace below 2 command\r\n// ------------------------------------------------------\r\n \r\n \r\n \r\n////////////////////////////////////////////////////////////////////////////////////////////////// \r\n// Stop / Profit  \r\n////////////////////////////////////////////////////////////////////////////////////////////////// \r\n \r\n \r\nstopLossPrice1 = 0;\r\nprofitTakePrice1 = 0;\r\n\r\n\r\n \r\nNumContracts = 1; \r\nPositionSize = NumContracts * MarginDeposit; \r\n// PositionSize = 30000;\r\n\r\n \r\n \r\n \r\n// \r\n// explorer columns \r\n//  \r\n // Filter=Buy OR Sell OR Short OR Cover; \r\n// Filter=(Month()==10 OR Month() == 9) AND Year() == 2025;\r\n// Filter = TimeNum() &gt;= 091500 AND TimeNum() &lt;= 094500; \r\nFilter = True;\r\n// Filter=short00; \r\n// Filter = buyFilterCond4;\r\n\r\n\r\nSetOption("NoDefaultColumns", True ); \r\nSetSortColumns(-3,-4); \r\nAddTextColumn( Name(), "Symbol"); \r\n \r\n//signal1 = WriteIf(Buy, "Buy", "Sell"); \r\n// AddColumn(Buy, "Trade", 1.2); \r\n// AddTextColumn(signal1, "Trade"); \r\nAddColumn(IIf(Buy, 66, 83), "Trade", formatChar, colorBlack, IIf(Buy, colorGreen, colorRed)); \r\nAddColumn( DateTime(), "Date", formatDateTime ); \r\nAddcolumn( Close, "Close price", 1.4 ); \r\nAddcolumn( Open, "Open price", 1.4 ); \r\nAddcolumn( H, "H price", 1.4 ); \r\nAddcolumn( L, "L price", 1.4 ); \r\n\r\n\r\n//AddColumn( dayOfMonth1, "dayOfMonth1", 1.5 ); \r\n//AddColumn( buycond1, "buycond1", 1.5 ); \r\n//AddColumn( shortcond1, "shortcond1", 1.5 ); \r\n\r\n\r\nAddColumn( buy, "buy", 1.5 ); \r\nAddColumn( sell, "sell", 1.5 ); \r\n\r\n\r\nAddColumn( stopLossPrice1, "stopLossPrice1", 1.5 ); \r\nAddColumn( profitTakePrice1, "profitTakePrice1", 1.5 ); \r\n\r\n/*\r\nAddColumn( minCO, "minCO", 1.5 ); \r\nAddColumn( maxCO, "maxCO", 1.5 ); \r\nAddColumn( hhvCOHist1, "hhvCOHist1", 1.5 ); \r\nAddColumn( LLVCOHist1, "LLVCOHist1", 1.5 ); \r\nAddColumn( hhvCHist1, "hhvCHist1", 1.5 ); \r\nAddColumn( llvCHist1, "llvCHist1", 1.5 ); \r\n*/\r\n\r\nAddColumn( regSlop20BarMaxCO, "regSlop20BarMaxCO", 1.5 ); \r\nAddColumn( regSlop20BarMinCO, "regSlop20BarMinCO", 1.5 );